{
    maps_state_dir = "state"
    maps_state_dir = ${?MAPS_STATE_DIR}
    maps_seed_dir = "coded_tools/config_files"
    maps_seed_dir = ${?MAPS_SEED_DIR}

    metadata = {
        description = "One planner handles episode-start, periodic, and episode-end work for the full-status sub-agent player arm."
        tags = ["MAPs", "ablation", "full-status", "multi-player", "single-planner"]
        sample_queries = [
            "kind=episode_start episode=1 step=0 cumulative_reward=0 final_reward=null"
            "kind=periodic episode=1 step=20 cumulative_reward=1500 final_reward=null"
            "kind=episode_end episode=1 step=100 cumulative_reward=90000 final_reward=90000"
        ]
    }

